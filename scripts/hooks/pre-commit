#!/bin/sh
# =============================================================================
# scripts/hooks/pre-commit — 拦截提交敏感凭据
# =============================================================================
# 触发时机：git commit 前
# 行为：
#   1. 检查待提交文件，匹配以下模式直接拒绝：
#      - .env / *.env / envs/*.env（环境变量文件）
#      - application-local.{yml,yaml,properties}
#      - *.pem / *.key / *.p12 / *.pfx
#   2. 扫描所有待提交 diff 的 ADDED 行，匹配敏感词（password / api_key /
#      secret / token + 真凭据特征）则拒绝
#
# 安装方式：
#   ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit
#
# 跳过方式（紧急情况，需 commit 时）：
#   git commit --no-verify
# =============================================================================

# 不开 set -e：grep 没匹配时返回 1，需要靠 || true 兜住
RED='\033[0;31m'
YEL='\033[1;33m'
GRN='\033[0m'

err() { printf '%b[pre-commit]%b %s\n' "$RED" "$GRN" "$*" >&2; }
warn() { printf '%b[pre-commit]%b %s\n' "$YEL" "$GRN" "$*" >&2; }
ok()   { printf '%b[pre-commit]%b %s\n' "$GRN" "$GRN" "$*"; }

# -----------------------------------------------------------------------------
# 1. 文件名黑名单
# -----------------------------------------------------------------------------
# 拦截真实 .env / .env.local 等；允许 *.env.example 模板入仓
FORBIDDEN_PATTERNS='(^|/)\.env$|(^|/)\.env\.(local|prod|production|dev|development|test|staging)$|(^|/)envs/[^/]+\.env$|(^|/)envs/[^/]+\.env\.(local|prod|production|dev|development|test|staging)$|application-local\.(yml|yaml|properties)$|\.pem$|\.key$|\.p12$|\.pfx$|docker-compose\.override\.yml$|docker-compose\.local\.yml$'

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)

if [ -z "$STAGED_FILES" ]; then
  ok "无 staged 文件，跳过检查"
  exit 0
fi

FORBIDDEN_FOUND=""
for f in $STAGED_FILES; do
  # *.example 永远放行（部署模板）
  case "$f" in
    *.example) continue ;;
  esac
  if echo "$f" | grep -qE "$FORBIDDEN_PATTERNS" 2>/dev/null; then
    FORBIDDEN_FOUND="$FORBIDDEN_FOUND $f"
  fi
done

if [ -n "$FORBIDDEN_FOUND" ]; then
  err "═══════════════════════════════════════════════════════════════"
  err "⛔ 检测到禁止提交的文件："
  for f in $FORBIDDEN_FOUND; do
    err "    - $f"
  done
  err "═══════════════════════════════════════════════════════════════"
  err "这些文件包含数据库密码、API key 等敏感凭据（AGENTS.md §6.4）。"
  err ""
  err "如果 .example 模板需要提交，请使用 *.env.example 后缀。"
  err "如果你确认这是误报（如安全测试用例），使用 --no-verify 跳过。"
  err "═══════════════════════════════════════════════════════════════"
  exit 1
fi

ok "✓ 文件名检查通过（未发现 .env / 凭据文件）"

# -----------------------------------------------------------------------------
# 2. 内容敏感词扫描
# -----------------------------------------------------------------------------
# 匹配规则：
#   KEY=VALUE 形式 (大写 KEY + = + 看起来像真凭据的字符串)
# 真凭据特征：长度 >= 16 且包含字母数字混合 / sk- 开头 / ghp_ 开头
# 例外：示例占位符 (YOUR_API_KEY_HERE / xxxxxxxx / change-me)
SENSITIVE_LINE_REGEX='(PASSWORD|API_KEY|SECRET|TOKEN|PRIVATE_KEY|ACCESS_KEY)[^a-zA-Z0-9]?[:=][^a-zA-Z0-9]?[A-Za-z0-9_-]{16,}'

EXCLUDE_LINES_REGEX='(YOUR_API_KEY_HERE|change-me|REPLACE_ME|\$\{[^}]+\}|^xxxx|placeholder|<[^>]+>|TODO|\.md:|\.md$|example)'

# 抓所有 staged diff 的 + 行
ADDED_LINES=$(git diff --cached -U0 2>/dev/null \
  | grep -E '^\+' 2>/dev/null \
  | grep -vE '^\+\+\+' 2>/dev/null)

if [ -z "$ADDED_LINES" ]; then
  ok "✓ 内容扫描通过（无新增行）"
  exit 0
fi

# 先抓敏感行
SENSITIVE_LINES=$(printf '%s\n' "$ADDED_LINES" | grep -iE "$SENSITIVE_LINE_REGEX" 2>/dev/null)

# 再排除占位符
if [ -n "$SENSITIVE_LINES" ]; then
  FILTERED=$(printf '%s\n' "$SENSITIVE_LINES" | grep -viE "$EXCLUDE_LINES_REGEX" 2>/dev/null)
else
  FILTERED=""
fi

if [ -n "$FILTERED" ]; then
  err "═══════════════════════════════════════════════════════════════"
  err "⛔ 检测到新增的敏感凭据行："
  printf '%s\n' "$FILTERED" | while IFS= read -r line; do
    [ -n "$line" ] && err "    $line"
  done
  err "═══════════════════════════════════════════════════════════════"
  err "可能误命中：示例占位符、单元测试数据。"
  err "如是误报，请修改为 YOUR_API_KEY_HERE / \${ENV_VAR} / xxx 占位符。"
  err "确认无误报时使用 --no-verify 跳过。"
  err "═══════════════════════════════════════════════════════════════"
  exit 1
fi

ok "✓ 内容扫描通过（未发现新增的明文凭据）"
exit 0
