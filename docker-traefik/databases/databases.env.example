# =============================================================================
# databases.env — 数据库服务自身的环境变量
# =============================================================================
# 用途：
#   - 由 docker-compose.yml 引用
#   - 仅供数据库容器内部使用（MySQL root 密码、MongoDB/Redis 自身配置）
#   - 应用连接信息在各项目自己的 .env 中维护
#     例：/opt/project/agent-insight/.env（见 docker-traefik/agent-insight/.env.example）
#     ~~旧路径 /opt/project/envs/db.env 已废弃（2026-08-09）~~
#
# 使用方法：
#   cp databases.env.example .env
#   # 编辑 .env，填入 MYSQL_ROOT_PASSWORD 等必填值
#   docker compose --env-file .env up -d
#
# 安全说明：
#   - 不要在此文件写默认密码；每个环境必须显式设置
#   - 不要把 .env 提交到 git
# =============================================================================

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
# 必填：MySQL root 密码（首次启动生效，docker-compose.yml 的 healthcheck 会引用）
MYSQL_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# 可选：MongoDB root 账号（留空表示无认证，仅本地/内网使用）
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
# 备注：业务库/用户由人工创建，不通过环境变量自动初始化

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# 备注：Redis 不需要初始密码，由人工在容器启动后手动设置

# ---------------------------------------------------------------------------
# PostgreSQL（agent-insight 当前不用，供云端其他项目共用）
# 镜像：pgvector/pgvector:0.8.6-pg18-bookworm（PG 18 + pgvector 0.8.6，Debian 12 stable）
# ---------------------------------------------------------------------------
# 必填：超级用户密码（首次启动生效，docker-compose.yml 的 healthcheck 会引用）
POSTGRES_PASSWORD=
# 可选：超级用户名（默认 postgres，留空走默认值）
POSTGRES_USER=
# 可选：默认数据库名（默认 postgres，首次启动时自动创建）
POSTGRES_DB=
# 可选：登录认证方式（默认 scram-sha-256；如遇老客户端不兼容可临时改 md5）
POSTGRES_HOST_AUTH_METHOD=
# 备注：
#   - 业务库/业务用户由人工创建，不通过环境变量自动初始化
#   - 启用 pgvector：在目标库执行 `CREATE EXTENSION IF NOT EXISTS vector;`
#     可写入 pgsql/init.sql 由首次启动自动执行（取消 yml 中的注释）
