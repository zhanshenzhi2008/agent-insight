# =============================================================================
# Agent Insight 项目环境变量（.env）
# =============================================================================
# 位置（生产）：/opt/project/agent-insight/.env
# 用法：
#   cp .env.example .env
#   编辑 .env 填写真实值
#   docker compose up -d
#
# 约定：
#   - 每个项目独立一份 .env，互不影响（不再使用 /opt/project/envs/）
#   - cogniforge / cogniforge-ai / cogniforge-web → 共用 /opt/project/cogniforge/.env
#   - agent-insight → 只用本目录 .env
#   - 本文件勿提交 git（已在 .gitignore）
#
# MYSQL_PASSWORD 须与 /opt/databases/.env 的 MYSQL_ROOT_PASSWORD 一致
# =============================================================================

# ------ 部署 / Traefik ------
# 完整访问域名（labels 与应用读取）
DOMAIN=insight.example.com
# 可选：镜像命名空间
# IMAGE_NAMESPACE=zhanshenzhi2008
# 可选：数据目录（默认 /opt/project/agent-insight/data）
# DATA_ROOT=/opt/project/agent-insight/data

# ------ MySQL ------
MYSQL_URL=jdbc:mysql://mysql:3306/agent_insight?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=UTF-8
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ------ MongoDB ------
MONGODB_URI=mongodb://mongodb:27017/agent_insight
MONGODB_PORT=27017

# ------ Redis ------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PWD=

# ------ PostgreSQL（agent-insight 当前不连；同机其他项目可参考） ------
PGSQL_HOST=pgsql
PGSQL_PORT=5432
PGSQL_PASSWORD=
PGSQL_USERNAME=postgres
PGSQL_DB=postgres
PGSQL_HOST_AUTH_METHOD=scram-sha-256

# ------ AI ------
# false = 不调用 LLM；仍需 SPRING_AI_MODEL_CHAT=openai，否则旧逻辑会默认激活 DeepSeek 并因缺 Key 启动失败
AI_ENABLED=false
AI_PROVIDER=openai
SPRING_AI_MODEL_CHAT=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 不要设空的 SPRING_AI_DEEPSEEK_API_KEY；不用 DeepSeek 就别写这两行
# SPRING_AI_DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=

# ------ JVM / 内存（对齐 ai-job-hunter-be） ------
# JAVA_OPTS=-XX:MaxRAMPercentage=70.0 -XX:InitialRAMPercentage=15.0 -XX:MaxMetaspaceSize=192m -XX:+ExitOnOutOfMemoryError -XX:+UseG1GC
# BE_MEM_LIMIT=768m
# BE_MEM_RESERVATION=256m
# IMAGE_TAG=latest
# IMAGE_NAMESPACE=zhanshenzhi2008
